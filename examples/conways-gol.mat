import std::io;

fn main() {
    // -----------------------------------------------------------------
    // Configuration: Change grid size here
    // -----------------------------------------------------------------
    let width: int = 128;
    let height: int = 32;
    let total_cells: int = width * height;

    io::println_str("================================================================================================================================");
    io::println_str("                                              CONWAY'S GAME OF LIFE (Dynamic)                                                   ");
    io::println_str("================================================================================================================================");

    // 1. Dynamic Grid Seeding
    let mut grid: Vec<int> = Vec::new();

    let mid_r: int = height / 2;
    let mid_c: int = width / 2;
    let lwss_r: int = height / 4;
    let lwss_c: int = width / 6;

    fori (let i: int = 0; i < total_cells; i++) {
        let r: int = i / width;
        let c: int = i % width;

        // Pattern 1: Glider (Top-Left)
        let is_glider: bool = (r == 1 && c == 2) || (r == 2 && c == 3) || (r == 3 && c == 1) || (r == 3 && c == 2) || (r == 3 && c == 3);

        // Pattern 2: Toad Oscillator (Centered)
        let is_toad: bool = (r == mid_r && c == mid_c) || (r == mid_r && c == mid_c + 1) || (r == mid_r && c == mid_c + 2) ||
                            (r == mid_r + 1 && c == mid_c - 1) || (r == mid_r + 1 && c == mid_c) || (r == mid_r + 1 && c == mid_c + 1);

        // Pattern 3: Lightweight Spaceship (Proportional Offset)
        let is_lwss: bool = (r == lwss_r && c == lwss_c + 1) || (r == lwss_r && c == lwss_c + 4) ||
                            (r == lwss_r + 1 && c == lwss_c) ||
                            (r == lwss_r + 2 && c == lwss_c) || (r == lwss_r + 2 && c == lwss_c + 4) ||
                            (r == lwss_r + 3 && c == lwss_c) || (r == lwss_r + 3 && c == lwss_c + 1) || (r == lwss_r + 3 && c == lwss_c + 2) || (r == lwss_r + 3 && c == lwss_c + 3);

        if (is_glider || is_toad || is_lwss) {
            grid.push(1);
        } else {
            // Dynamic pseudo-random background noise (~20% fill density)
            let hash: int = (r * 7919 + c * 104729 + (r * c) * 3137 + (r + c) * 17) % 100;
            if (hash < 20) {
                grid.push(1);
            } else {
                grid.push(0);
            }
        }
    }

    let mut gen: int = 0;

    // 2. Simulation Loop
    loop {
        println("\n--- Generation {gen} ---");

        // Render grid dynamically (packing 2 vertical cells per line)
        let mut render_r: int = 0;
        while render_r < height {
            fori (let c: int = 0; c < width; c++) {
                let top_idx: int = render_r * width + c;
                let bot_row: int = render_r + 1;
                let bot_idx: int = bot_row * width + c;

                let top: int = grid[top_idx];
                let mut bot: int = 0;
                if (bot_row < height) {
                    bot = grid[bot_idx];
                }

                if (top == 1 && bot == 1) {
                    io::print_str("█");
                } else if (top == 1 && bot == 0) {
                    io::print_str("▀");
                } else if (top == 0 && bot == 1) {
                    io::print_str("▄");
                } else {
                    io::print_str(" ");
                }
            }
            println("");
            render_r += 2;
        }

        // Compute next generation
        let mut next_grid: Vec<int> = Vec::new();

        fori (let r: int = 0; r < height; r++) {
            fori (let c: int = 0; c < width; c++) {
                let mut neighbors: int = 0;

                let mut dr: int = -1;
                while dr < 2 {
                    let mut dc: int = -1;
                    while dc < 2 {
                        if (dr == 0 && dc == 0) {
                            dc++;
                            continue;
                        }

                        let mut nr: int = r + dr;
                        let mut nc: int = c + dc;

                        // Dynamic Toroidal boundary wrapping
                        if nr < 0 {
                            nr = height - 1;
                        }
                        if nr >= height {
                            nr = 0;
                        }
                        if nc < 0 {
                            nc = width - 1;
                        }
                        if nc >= width {
                            nc = 0;
                        }

                        let n_idx: int = nr * width + nc;
                        if grid[n_idx] == 1 {
                            neighbors++;
                        }

                        dc++;
                    }
                    dr++;
                }

                let cell_idx: int = r * width + c;
                let current_cell: int = grid[cell_idx];

                if (current_cell == 1 && (neighbors == 2 || neighbors == 3)) {
                    next_grid.push(1);
                } else if (current_cell == 0 && neighbors == 3) {
                    next_grid.push(1);
                } else {
                    next_grid.push(0);
                }
            }
        }

        grid = next_grid;
        gen++;

        io::print_str("\n[Press Enter to step, or type 'q' to quit]: ");
        let user_input: String = io::read_console();
        if user_input == "q" {
            io::println_str("Exiting Game of Life.");
            break;
        }
    }
}
