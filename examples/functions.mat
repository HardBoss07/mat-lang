fn print_separator() {
    println("========================================");
}

fn greet_user(age: int, is_admin: bool) {
    if (is_admin == tru) {
        println("Welcome Admin! Age: {age}");
    } else {
        println("Welcome User! Age: {age}");
    }
}

fn add(a: int, b: int) -> int {
    return a + b;
}

fn is_even(n: int) -> bool {
    if (n % 2 == 0) {
        return tru;
    }
    return fal;
}

fn divide(numerator: int, denominator: int) -> Result<int, String> {
    if (denominator == 0) {
        return Err("Division by zero error");
    }
    return Ok(numerator / denominator);
}

fn main() {
    print_separator();
    greet_user(18, tru);

    print_separator();
    let sum: int = add(15, 27);
    let even: bool = is_even(sum);
    println("Sum: {sum}, Is Even: {even}");

    print_separator();
    let valid_res: Result<int, String> = divide(100, 5);
    let error_res: Result<int, String> = divide(42, 0);

    match (valid_res) {
        Ok(value) => println("Result: {value}");
        Err(err)  => println("Error: {err}");
    }

    match (error_res) {
        Ok(value) => println("Result: {value}");
        Err(err)  => println("Error: {err}");
    }
}