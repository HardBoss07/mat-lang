                callee: "Shape::Circle"
                arguments:
                  - FloatLiteral:
                      - 3.14
        - Match:
            expr:
              Identifier:
                - s
            arms:
              - pattern:
                  EnumTuple:
                    enum_name: ~
                    variant: "Shape::Circle"
                    vars:
                      - r
                body:
                  - Let:
                      name: area
                      is_mutable: false
                      ty: F64
                      value:
                        Identifier:
                          - r
              - pattern:
                  EnumTuple:
                    enum_name: ~
                    variant: "Shape::Rectangle"
                    vars:
                      - w
                      - h
                body:
                  - Let:
                      name: perim
                      is_mutable: false
                      ty: Int
                      value:
                        Binary:
                          op: Add
                          left:
                            Identifier:
                              - w
                          right:
                            Identifier:
                              - h
              - pattern:
                  EnumStruct:
                    enum_name: ~
                    variant: "Shape::Label"
                    fields:
                      - - title
                        - title
                      - - is_visible
                        - is_visible
                body:
                  - Let:
                      name: t
                      is_mutable: false
                      ty: String
                      value:
