            Struct:
              - is_pub: false
                name: title
                ty: String
              - is_pub: false
                name: is_visible
                ty: Bool
        - name: Empty
          payload: Unit
  - Function:
      is_pub: false
      name: main
      params: []
      return_type: Void
      body:
        - Let:
            name: s
            is_mutable: false
            ty:
