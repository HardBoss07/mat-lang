declare void @_mat_rt_println_bool(i1)

declare ptr @_mat_rt_read_line()

declare ptr @_mat_rt_file_open(ptr, ptr)

declare i1 @_mat_rt_file_close(ptr)

declare ptr @_mat_rt_file_read_line(ptr)

declare ptr @_mat_rt_file_read_to_string(ptr)

declare i64 @_mat_rt_file_write(ptr, ptr)

declare i1 @_mat_rt_file_flush(ptr)

declare i64 @_mat_rt_file_seek(ptr, i64, i32)

